# ==============================================================================
# AI School OS — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in secure values for your production deployment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Runtime & Networking
ENVIRONMENT=production
DEBUG=False
PORT=80
TRUST_PROXY=True
ALLOWED_ORIGINS=https://app.schoolos.com,http://localhost

# PostgreSQL Database Configuration
POSTGRES_DB=school_erp
POSTGRES_USER=school_user
POSTGRES_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DATABASE_URL=postgresql://school_user:YOUR_SECURE_DATABASE_PASSWORD_HERE@db:5432/school_erp

# Core Cryptographic Keys & JWT Configuration
# Generate a cryptographically strong 64-character secret (e.g., openssl rand -hex 32)
SECRET_KEY=YOUR_SECURE_64_CHARACTER_RANDOM_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Document Storage Configuration
DOCUMENT_STORAGE_PATH=/app/storage/documents
DOCUMENT_MAX_SIZE_MB=10
STORAGE_PROVIDER=local

# Rate Limiting & Security Defaults
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# ==============================================================================
# Payment Gateways (Razorpay & Stripe) — Phase 25.2 / 30.6
# Tenant-specific credentials can also be configured dynamically in the Settings UI
# ==============================================================================
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ==============================================================================
# Communication Gateways (WhatsApp & SMS) — Phase 27.3
# ==============================================================================
WHATSAPP_WEBHOOK_VERIFY_TOKEN=school_erp_whatsapp_verify_token_secure
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# ==============================================================================
# AI Provider Gateway (Gemini / OpenAI) — Phase 29.0
# ==============================================================================
# Tenant-specific AI keys can be configured per school in the AI Settings UI
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
