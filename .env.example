# AI School OS Root Environment Template
# COPY THIS FILE TO .env AND FILL IN ACTUAL SECURE CREDENTIALS FOR YOUR ENVIRONMENT
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

ENVIRONMENT=production
DEBUG=False

# Database Configuration
POSTGRES_DB=school_erp
POSTGRES_USER=school_user
POSTGRES_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DATABASE_URL=postgresql://school_user:YOUR_SECURE_DATABASE_PASSWORD_HERE@db:5432/school_erp

# Core Security Secret Key
SECRET_KEY=YOUR_SECURE_64_CHARACTER_RANDOM_SECRET_KEY_HERE
