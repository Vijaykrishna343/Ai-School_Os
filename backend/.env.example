# Environment Configuration Template (Placeholders only)
APP_NAME=AI School OS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/school_erp

# Security & Secrets (Must be changed in production)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_32_BYTE_RANDOM_SECRET_IN_PRODUCTION

# Token Expiry Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated or JSON array)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
